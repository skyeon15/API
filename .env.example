# Database Configuration
API_DB_HOST=localhost
API_DB_PORT=5432
API_DB_NAME=pds_api
API_DB_USER=admin
API_DB_PASSWORD=devpass

# Redis Configuration
API_REDIS_HOST=localhost
API_REDIS_PORT=6379

# Server Configuration
API_PORT=10151
API_URL=http://localhost:10151
API_WEB_URL=http://localhost:10150
API_ALLOWED_ORIGINS=https://*.bbforest.net,https://*.riri.li,https://*.hapbbi.com

# Authentication
API_JWT_SECRET=your_jwt_secret_here

# Social Login (OAuth2)
API_KAKAO_CLIENT_ID=your_kakao_client_id
API_KAKAO_CLIENT_SECRET=your_kakao_client_secret
API_NAVER_CLIENT_ID=your_naver_client_id
API_NAVER_CLIENT_SECRET=your_naver_client_secret
API_GOOGLE_CLIENT_ID=your_google_client_id
API_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Aligo Alimtalk API
API_ALIGO_API_KEY=your_aligo_key
API_ALIGO_USER_ID=your_aligo_user_id
API_ALIGO_FAILOVER=Y
API_VERIFY_CHANNEL_ID=your_channel_id
API_VERIFY_TEMPLATE_CODE=your_template_code

# Payapp API
API_PAYAPP_USERID=your_payapp_id
API_PAYAPP_LINKKEY=your_payapp_linkkey
API_PAYAPP_RESELLERID=your_payapp_reseller_id

# Stripe (플랫폼이 Merchant of Record — 계정 하나를 전 서비스가 공유한다)
API_STRIPE_SECRET_KEY=sk_test_your_key
API_STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret
# 🔴 공개키는 web 용 이름 하나로 둔다(단일 이미지라 api 프로세스도 같은 env 를 받는다).
#    GET /stripe/config 가 이 값을 연동 서비스에 내려 준다 — 서비스마다 복사해 두면
#    test→live 전환 때 그쪽만 옛 키로 남아 조용히 깨진다.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Frontend (Web)
# 브라우저는 상대경로(/api)로 호출하므로 공개 API URL은 필요 없다.
# web→api 프록시 타깃(서버사이드 전용). 비우면 기본값 http://localhost:10151 사용.
# API_PROXY_TARGET=http://localhost:10151
